# Mapbox Token (Required for map functionality)
# Get your token from https://account.mapbox.com/
MAPBOX_TOKEN=your_mapbox_token_here

# Backend Configuration
# Database URL - for PostgreSQL: postgresql://user:password@host:port/database
# For development with SQLite: sqlite:///./saferoute.db
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/saferoute
# Database connection pool settings
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800

# Debug mode - set to False in production
DEBUG=False

# Secret key for JWT token generation
# Generate with: openssl rand -hex 32
SECRET_KEY=your_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256

# CORS Origins - comma-separated list
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://yourdomain.com

# Rate Limiting (requests per minute)
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Redis Configuration (for caching)
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password  # Uncomment and set if using password

# PostgreSQL Connection Details (alternative to DATABASE_URL)
POSTGRES_SERVER=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=saferoute

# Application Settings
APP_NAME=SafeRoute AI API
APP_VERSION=0.1.0

# Security - API Keys
API_KEY_REQUIRED=false
API_KEYS=your_api_key_here,another_api_key_here

# Rate Limiting
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10
RATE_LIMIT_PER_METHOD=true
RATE_LIMIT_EXEMPT_PATHS=/,/health,/docs,/redoc,/openapi.json,/debug/env

# Request Size Limits
REQUEST_SIZE_LIMIT_ENABLED=false
REQUEST_SIZE_LIMIT_BYTES=5242880  # 5MB in bytes
REQUEST_SIZE_LIMIT_EXEMPT_PATHS=/,/health,/docs,/redoc,/openapi.json,/debug/env

# Timeout Handling
REQUEST_TIMEOUT_ENABLED=false
REQUEST_TIMEOUT_SECONDS=30
REQUEST_TIMEOUT_EXEMPT_PATHS=/,/health,/docs,/redoc,/openapi.json,/debug/env
DB_QUERY_TIMEOUT_SECONDS=10

# Security Headers
SECURITY_HEADERS_ENABLED=true
STRICT_TRANSPORT_SECURITY_MAX_AGE=31536000  # 1 year
CONTENT_SECURITY_POLICY="default-src 'self'"
TRUSTED_PROXY_ENABLED=false
TRUSTED_PROXY_COUNT=1

# Slow Request Logging
SLOW_REQUEST_THRESHOLD=1.0
SLOW_REQUEST_LOG_ENABLED=true

# Safety scoring weights (0.0 to 1.0)
SAFETY_WEIGHT_DEFAULT=0.7
SAFETY_WEIGHT_MIN=0.0
SAFETY_WEIGHT_MAX=1.0

# Penalty configuration for routing algorithm
CRIME_HOTSPOT_HIGH_PENALTY_BASE=2500.0
CRIME_HOTSPOT_MEDIUM_PENALTY=500.0
CRIME_HOTSPOT_LOW_PENALTY=100.0
SAFETY_NODE_LOW_LIGHTING_PENALTY=50.0
SAFETY_NODE_SPARSE_CROWD_PENALTY=30.0
USER_REPORT_BASE_PENALTY=100.0
HIGH_RISK_SEGMENT_MULTIPLIER=3.0
HIGH_RISK_SEGMENT_ADDITIONAL_FACTOR=0.5
SEGMENT_RISK_BASE_PENALTY=500.0
SEGMENT_RISK_SEARCH_RADIUS_M=200.0
SAFETY_SCORE_MAX_PENALTY=2500.0

# Routing algorithm parameters
DEFAULT_SEARCH_RADIUS_METERS=2000.0
BASE_SEARCH_RADIUS_METERS=5000.0
DEFAULT_INTERPOLATION_POINTS=20
PATH_VARIATION_COUNT=5
GRAPH_NEIGHBOR_COUNT=30
RISK_FACTOR_SAFETY=3.0
RISK_FACTOR_LIGHTING=4.0
RISK_FACTOR_CROWD=1.5
ROUTE_COST_ALPHA=50.0

# Mapbox API Configuration
MAPBOX_DIRECTIONS_TIMEOUT_SEC=15

# Weather cache settings
WEATHER_CACHE_MAX_SIZE=1000
WEATHER_CACHE_TTL_SECONDS=300

# File upload settings (if applicable)
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=10485760  # 10MB

# Frontend Configuration (for built frontend served by backend)
# NEXT_PUBLIC_API_URL is used by the frontend to communicate with backend
NEXT_PUBLIC_API_URL=http://localhost:8000